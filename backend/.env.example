# Porta da API. No Render é injetada automaticamente — não precisa definir lá.
PORT=3001

# Connection string do Postgres (Supabase). Pegue em Project Settings ->
# Database -> Connection string -> "Session pooler" (não "Direct connection",
# que é IPv6-only e pode não funcionar no Render; não "Transaction pooler",
# que não é ideal para conexões persistentes de servidor).
# Exemplo: postgresql://postgres.xxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Segredo do JWT. Se não definido, o backend gera um sozinho e salva em
# DATA_DIR/.jwt_secret (ok para dev). Em produção, defina explicitamente
# (no Render, marque "Generate value" para o Render criar um aleatório).
JWT_SECRET=

# Origem(ns) permitidas por CORS, separadas por vírgula. Sem isso, libera
# qualquer origem (ok só em desenvolvimento local).
# Exemplo: CORS_ORIGIN=https://seu-site.netlify.app
CORS_ORIGIN=

# Pasta onde fica o segredo do JWT (e, só durante a migração pontual pro
# Postgres, onde o script scripts/migrar-para-postgres.js procura o antigo
# clinica.db). Sem isso, usa backend/data (ok em dev).
DATA_DIR=

# Pasta onde ficam os uploads (logos, fotos, comprovantes, PDFs). Sem isso,
# usa backend/uploads (ok em dev). Em produção (Render), aponte para o disco
# persistente, ex: /var/data/uploads
UPLOADS_DIR=
